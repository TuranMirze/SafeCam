@model EmployeeCreateVM;

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Employee create</h6>
    </div>
    <div class="card-body">
        <form enctype="multipart/form-data" method="post">
            <div class="form-group">
                <label asp-for="Name">Name</label>
                <input class="form-control" asp-for="Name">
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName">Description</label>
                <textarea class="form-control" asp-for="LastName"></textarea>
                <span class="text-danger" asp-validation-for="LastName"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoverFile">CoverFile</label>
                <input class="form-control" asp-for="CoverFile">
                <span class="text-danger" asp-validation-for="CoverFile"></span>
            </div>
            <div class="form-row">
                <div class="form-group col">
                    <label asp-for="Position">Position</label>
                    <input class="form-control" asp-for="Position">
                    <span class="text-danger" asp-validation-for="Position"></span>
                </div>
                <div class="form-group col">
                    <label asp-for="Salary">Salary</label>
                    <input class="form-control" asp-for="Salary">
                    <span class="text-danger" asp-validation-for="Salary"></span>
                </div>
            </div>

            @* <div class="form-row">
                <div class="form-group col">
                    <label asp-for="">Categories</label>
                    <select asp-for="" class="form-control" asp-items='new SelectList(ViewBag.Categories,"Id","Name")'>
                        <option selected disabled>Select Categories</option>
                        @foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                    <span class="text-danger" asp-route-id="CategoryId"></span>
                </div>
            </div> *@
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>
